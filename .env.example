NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_platform
# A long random value, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production. Without it a random secret is used per run (sign-ins end on restart).
JWT_SECRET=replace-with-a-long-random-secret
# Pages served by this server may always call the API. List OTHER sites here (comma separated).
CORS_ORIGIN=http://localhost:3000
COMPANY_NAME=ET CETRA ADVOCATES COMPANY LIMITED
# AI Support (public website chat). By default it uses a Qwen model on this
# computer through Ollama (https://ollama.com), so questions never leave the PC.
# It only knows the public facts in backend/src/data/support-knowledge.js.
# SUPPORT_AI=0                 turn the AI off (verified answers only)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b      default: first installed local model named qwen
# OLLAMA_TIMEOUT_MS=60000
# SUPPORT_AI_SWAHILI=1         let the AI answer Kiswahili too (only with a model that writes good Kiswahili)
# Optional: cloud Qwen instead of Ollama (questions are then sent to Alibaba Cloud)
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3-max
